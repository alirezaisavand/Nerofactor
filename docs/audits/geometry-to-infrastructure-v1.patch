+    dirs = np.stack([x, -y, -np.ones_like(x)], axis=1)  # OpenGL camera rays
+    dirs /= (np.linalg.norm(dirs, axis=1, keepdims=True) + 1e-8)
+    pts_cam_gl = dirs * r[:, None]
+    return pts_cam_gl.astype(np.float32)
