+def compute_psnr(img_gt, img_pr):
+    img_gt = img_gt.reshape([-1, 3]).astype(np.float32)
+    img_pr = img_pr.reshape([-1, 3]).astype(np.float32)
+    mse = np.mean((img_gt - img_pr) ** 2, 0)
+    mse = np.mean(mse)
+    psnr = 10 * np.log10(255 * 255 / mse)
+    return psnr
